NOMINATIM_RESULT_LIMIT=8
NOMINATIM_TIMEOUT_MS=8000
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=20000
OVERPASS_NEARBY_LIMIT=30

