{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "rootDirectory": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "rootDirectory": "backend"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "service": "backend",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "service": "frontend",
      "dest": "/$1"
    }
  ]
}